{
  "manifest_version": 3,
  "name": "豆瓣/IMDb 抓取助手",
  "version": "3.0",
  "description": "抓取豆瓣页面(日期/评分/又名/外文标题/IMDb ID/主创/简介)与IMDb页面(评分)，下载为 json",
  "permissions": [
    "scripting",
    "downloads",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.douban.com/*",
    "*://*.imdb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "scrape-page": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "抓取当前页面（自动识别豆瓣或IMDb）"
    }
  }
}